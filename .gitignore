# User-specific files
*.suo
*.user
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
x64/
[Bb]uild/
[Bb]in/
[Ll]ibrary/
[Tt]emp/
[Oo]bj/

# Visual Studio profiler
*.psess
*.vsp
*.vspx

# NuGet package restore at repo root only (do not ignore Unity Packages/)
/packages/
nuget/*.nupkg

# Others
*.dtd
# **公式 DTD だけは置く。** 手書きの写し（Core/DTD.fs の doc）と
# 突き合わせる相手で、無いと Core.Tests の OfficialDtd が材料を失う。
# BSD（readme_e.txt を同じところに置いてある）
!license/bulletml/relax/bulletml.dtd

# Unity - Autogenerated VS/MD solution and project files
/*.csproj
/*.unityproj
/*.sln
!/FsBulletML2.Library.sln
/*.suo
/*.user
/*.userprefs
/*.pidb
/*.booproj
# Unity generated / machine-local (samples)
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/.vs/
**/.vsconfig
samples/**/Assembly-CSharp*.csproj
# Unity 6 は asmdef ごとに csproj を作る。**Unity プロジェクトの直下 だけ**外す
# （隣 の *.Compile は本物 なので、samples/**/*.csproj にはしない）
samples/FsBulletML2.Sample.Unity2D.MagicOnion/*.csproj
samples/**/*.slnx
!samples/FsBulletML2.Sample.TypeProviders.Debug/FsBulletML2.Sample.TypeProviders.Debug.slnx
samples/**/*.csproj.user

src/FsBulletML2.LanguageService.Js/js/
# 面 は Danmaku Lab へ出たが、**手元に焼いた跡が残る**（Fable は消さない）
src/FsBulletML2.Playground/
src/FsBulletML2.Playground/.tools/

# leftover from Unity IAP default package
**/BillingMode.json
**/BillingMode.json.meta

# Unity accidentally creates these if the repo root or F# lib is opened as a project
/ProjectSettings/
src/FsBulletML2.Unity2D/ProjectSettings/
src/FsBulletML2.Unity2D/Packages/

# カバレッジ収集の出力（dotnet test --collect が吐く）
TestResults/

# ---- FsBulletML-2 の初期 .gitignore から（重複は除いてある） ----
## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore
[Rr]eleases/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/
# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
# ASP.NET Scaffolding
ScaffoldingReadMe.txt
# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg
# dotenv environment variables file
.env
~$*
*~
CodeCoverage/
# MSBuild Binary and Structured Log
*.binlog
# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# BenchmarkDotNet が走らせるたびに repo の根元へ吐くもの
BenchmarkDotNet.Artifacts/

# Godot 4 のインポート キャッシュ と、mono の中間物。
# **.godot/mono/temp/bin に dll が出る** —— Unity の Library/ と同じ立場
.godot/
