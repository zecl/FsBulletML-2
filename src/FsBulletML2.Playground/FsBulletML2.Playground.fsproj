<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <!--
      例外の文面を鍵でなく字で出す。Blazor WASM の SDK は Release で
      これを立てるので、`Xml_TagMismatchEx` のような resource key が返る。
      Apply の理由をそのまま人へ見せるので、切る。

      **代償を測った: 6 バイト**（46,762,424 -> 46,762,418）。
      `PublishTrimmed` が false なので resource の字はもともと dll に在り、
      この設定は「使うかどうか」しか変えない。
      **trim を入れたら測り直すこと** —— そのときは本当に太る。
    -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <!--
      **publish した成果物だけが起動しなかった。**

      SDK は publish のとき資産に指紋を付け（`dotnet.<hash>.js`）、素の名前との
      対応を **インラインの `<script type="importmap">`** で html に入れる。
      この app の CSP は `script-src` に `'unsafe-inline'` を出していないので
      **その importmap が効かない** —— boot が `_framework/dotnet.js` を素の名前で
      取りに行って落ち、`#loop-error` が「起動待ち」のまま止まる。

      **どこにも出なかった** —— dev server は指紋を付けないので素の名前で解決し、
      CI は `dotnet publish` を 1 回 も走らせていない。門は**ソースの**
      index.html を見ていて、しかも空の importmap は数えないと決めてあった。
      **人が書く script は見ていたが、SDK が後から入れる script は見ていなかった。**

      指紋を止めるのが、CSP を緩めずに済む道 —— hash は publish のたびに
      変わるので html に焼けないし、nonce はリクエストごとに配るサーバが要る。

      **2 つ 要る。** 1 つ では半端になる（clean publish で測った）——

          WasmFingerprintAssets=false だけ    dotnet.js は素になるが
                                             blazor.webassembly は指紋つきのまま
          StaticWebAssetFingerprintingEnabled  同上（この app では効かない）
          + BlazorFingerprintBlazorJs=false   **両方 素になり、importmap が空になる**

      指紋を止めた時点で `#[.{fingerprint}]` の埋め込みも止まる（置換されずに
      そのまま残る）ので、index.html は素の名前で書く。
      `OverrideHtmlAssetPlaceholders` はそのための設定だったので一緒に落とした。

      **incremental の成果物で判定しない。** 指紋つきで焼いた `obj` が残った
      まま publish すると、置換済みの html が出てきて直ったように見える
      （実際に一度 読み違えた）。門は clean からの publish に当てる。

      publish した物が起動する形かは `guard-published-boot.ps1` が見ている
      （CI の `Build · Playground` の中）。
    -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <BlazorFingerprintBlazorJs>false</BlazorFingerprintBlazorJs>
  </PropertyGroup>
  <!--
    AOT を測るための口。**既定では立たない** —— 立てるのは

        dotnet publish ... -p:PlaygroundAot=true

    **`-p:` は全部 の proj の全部 の TFM に降る。** Core / Front / Dsl /
    Bullets.Dsl は `net10.0;netstandard2.1` の多段（Unity 向け）で、
    netstandard2.1 はトリミングできないので、`PublishTrimmed` を
    直に `-p:` で渡すと落ちる。**ここで受けて、ここでだけ立てる。**

    **立てたあとは `obj` を消してから焼き直すこと。**
    AOT の成果物は `obj/Release/net10.0/wasm/for-publish/` に残り、
    **次の publish が `PlaygroundAot` 無しでもそれを拾う** ——
    publish のログに `wasm-opt` が出ていたら、それは AOT の工程。
    （v4.9.2 の実測で踏んだ：速い道の効きを測ろうとして、
    AOT 込みの物と素の物を並べていた。**起動しないので気づけた**が、
    起動していたら「効きが出ない」と読み違えていた。）
  -->
  <PropertyGroup Condition="'$(PlaygroundAot)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>
  <!--
    ## 焼けないときの逃げ道（v4.9.4 で測った）

    **メモリで殺されるのはリンクの工程。** AOT のコンパイル（82 本）は
    毎回 最後まで通るのに、`Linking with emcc with -O2` で 12 GB 超 を要る ——
    段 4 で「メモリ不足なので札のまま残す」と書いたのは、
    **逃げ道を探さずに諦めていた。** 3 つ ある。

        -p:DisableParallelAot=true            AOT を 1 本 ずつ
        -p:DisableParallelEmccCompile=true    native を 1 本 ずつ
        -p:EmccLinkOptimizationFlag=-O1       **これが効いた**

    この機械（空き 13 GB）では 3 つ 目 を入れて 880 秒 で通った。

    ## 大きさを削る設定は、ほぼ既定で効いている

        WasmStripILAfterAOT              **既定が true**（SDK の targets）
        EmccCompileOptimizationFlag      **既定が -Oz**
        EmccLinkOptimizationFlag         既定は -O2。ここだけ動かせる

    最初の 2 つ を明示で書いても**何も変わらない** ——
    「効いているように見えて何もしない設定」になるので書かない。
    そして `dotnet.native.wasm` は**焼いた機械語そのもの**なので、
    IL を落としても痩せない。
  -->
  <!-- **語彙・補完・hover・診断はここに無い。** 器
       （FsBulletML2.LanguageService と .Host）へ移した。ここに残るのは
       ブラウザのアプリそのもの —— 描画の場と、JS から呼ばれる口。 -->
  <ItemGroup>
    <Compile Include="Stage.fs" />
    <!-- 種から決まる乱数。**`System.Random` を使わない**（種を Share に乗せる） -->
    <Compile Include="Rand.fs" />
    <!-- 自機の動かし方。**式は BrowserEnv の外**（.NET から当てられる形で） -->
    <Compile Include="Player.fs" />
    <Compile Include="BrowserEnv.fs" />
    <Compile Include="Pacing.fs" />
    <Compile Include="Seek.fs" />
    <!-- 2 面 が分かれるコマまで送る（v3.8）。**数ではなく位置で見る** -->
    <Compile Include="Diverge.fs" />
    <!-- 追っている弾の再開点（v3.1 の段 3）。**受け口を繋ぐのはここ 1 か所** -->
    <Compile Include="Focus.fs" />
    <Compile Include="Playfield.fs" />
    <Compile Include="Main.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Bolero" Version="0.25.63" />
    <PackageReference Include="Bolero.Build" Version="0.25.63" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.*" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="CompilePlaygroundJs" BeforeTargets="BeforeBuild">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="dotnet tool run fable -- fable/FsBulletML2.Playground.Js.fsproj -o wwwroot/js" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\FsBulletML2.Core\FsBulletML2.Core.fsproj" />
    <ProjectReference Include="..\FsBulletML2.Front\FsBulletML2.Front.fsproj" />
    <ProjectReference Include="..\FsBulletML2.Dsl\FsBulletML2.Dsl.fsproj" />
    <ProjectReference Include="..\FsBulletML2.Parser\FsBulletML2.Parser.fsproj" />
    <ProjectReference Include="..\FsBulletML2.Bullets.Dsl\FsBulletML2.Bullets.Dsl.fsproj" />
    <!-- **Fable 側（`fable/FsBulletML2.Playground.Js.fsproj`）も同じものを参照する。**
         あちらは Fable がソースから焼き、こちらは .NET が dll にする。
         答えが一致することは `guard-fable-parity.ps1` が走行で見ている -->
    <ProjectReference Include="..\FsBulletML2.LanguageService\FsBulletML2.LanguageService.fsproj" />
    <ProjectReference Include="..\FsBulletML2.LanguageService.Host\FsBulletML2.LanguageService.Host.fsproj" />
  </ItemGroup>
</Project>
