<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- 順は依存の順。JSON 読みを先に、Monaco のバインディング、配線を後に。

       **語彙・補完・hover の中身はここに無い。** 器
       （FsBulletML2.LanguageService）へ移した。Fable は ProjectReference を
       辿ってあちらのソースも焼き、出力は wwwroot/js/<proj 名>/ に入る。

       ここに残っているのは **Fable でしか走らないもの** ——
       VocabularyJson は [<Emit>]、Monaco と Playground はブラウザの API。 -->
  <ItemGroup>
    <Compile Include="VocabularyJson.fs" />
    <!-- 圧縮。**組み立てと base64url はここに無い**（器の ShareLink）——
         あちらは .NET でも走るので、突き合わせと .NET の試験が当たる -->
    <Compile Include="Share.fs" />
    <Compile Include="Monaco.fs" />
    <Compile Include="Playground.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\FsBulletML2.LanguageService\FsBulletML2.LanguageService.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="5.0.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.20.0" />
  </ItemGroup>
</Project>
