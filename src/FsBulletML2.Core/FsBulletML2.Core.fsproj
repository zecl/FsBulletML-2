<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>FsBulletML2.Core</RootNamespace>
    <AssemblyName>FsBulletML2.Core</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>FsBulletML2.Core</PackageId>
    <Description>BulletML engine written in F#. Runs danmaku (bullet-hell) patterns as a pure step function; no game framework required.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Exception.fs" />
    <Compile Include="AST.fs" />
    <Compile Include="Util.fs" />
    <Compile Include="Expr.fs" />
    <Compile Include="DTD.fs" />
    <Compile Include="Trace.fs" />
    <Compile Include="Domain.fs" />
    <Compile Include="Sim.fs" />
    <Compile Include="Eval.fs" />
    <Compile Include="BulletmlRead.fs" />
    <Compile Include="BulletmlOps.fs" />
    <Compile Include="Step.fs" />
    <Compile Include="Api.fs" />
    <Compile Include="BulletmlInfo.fs" />
  </ItemGroup>
</Project>
