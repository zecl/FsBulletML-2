<Project Sdk="Microsoft.NET.Sdk">
  <!--
    エディタの中身（語彙・補完・hover）を置く器の、**2 つ の runtime で
    走る側**。読む段と reflection は `FsBulletML2.LanguageService.Host`。

    ## 参照してよいもの

    Core / Parser までの、表示を知らない側だけ。**Monaco も Bolero も
    Blazor も参照しない** —— 参照した瞬間に Monaco 以外 のエディタへ
    載せられなくなるが、それは build でも試験でも出ず、載せ替えようと
    した版で初めて分かる。門で見ている
    （`.github/scripts/guard-playground-boundaries.ps1` の 2 つ目）。

    いまは何も参照していない。**Parser も参照しない** —— FParsec は dll 参照で
    F# ソースを含まないので、参照した瞬間に Fable が焼けなくなる（v0.8 で実測）。

    ## 2 つ の runtime で走る

    ここのソースは host（Blazor WASM の .NET）と ブラウザ側（Fable が
    焼いた JS）の**両方 で走る**。Fable 側は `FsBulletML2.LanguageService.Js.fsproj` が
    `ProjectReference` で引き、Fable がソースから焼く。

    **`Fable.Core` に依存しない形で書くこと。** 依存すると host 側の
    build が壊れる。答えが 2 つ の runtime で一致することは
    `guard-fable-parity.ps1` が走行で見ている。

    ## 配らない

    nuspec を足さない。ブラウザのエディタのための器で、
    Core / Front / Parser のように他所へ配る物ではない。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>FsBulletML2.LanguageService</RootNamespace>
    <AssemblyName>FsBulletML2.LanguageService</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- 順は依存の順。表記に依らない側（Scan / SourceLanguage / Lookup）が先で、
         表記ごとのもの（XmlScan / SxmlScan / Languages の下）が後 -->
    <Compile Include="SourceKind.fs" />
    <!-- 共有リンクの組み立てと base64url。**圧縮はここに無い** ——
         `CompressionStream` はブラウザにしか無く、ここは 2 つ の runtime で走る -->
    <Compile Include="ShareLink.fs" />
    <Compile Include="Scan.fs" />
    <Compile Include="XmlScan.fs" />
    <Compile Include="SxmlScan.fs" />
    <Compile Include="FsbScan.fs" />
    <!-- F# の CE の字を数える 1 本。**返すのは名前だけ**（要素・属性の形が無い） -->
    <Compile Include="FsharpScan.fs" />
    <!-- 綴りの近さ。**数を返さない**（上限を字に出さない） -->
    <Compile Include="Distance.fs" />
    <!-- 参照の規則。**host の波線と ブラウザの rename / Quick Fix が同じ 1 本 を引く** -->
    <Compile Include="Refs.fs" />
    <!-- 式が読めるかを字から見る（v4.1）。**値は出さない** ——
         評価器を 2 本 持つと同じ式が 2 通り の値になる。
         Core の `Expr.parse` との突き合わせは `ExprParity` が数える -->
    <Compile Include="ExprCheck.fs" />
    <!-- 意味の層（v2.3）。**字から数える** —— 打鍵ごとに回すので WASM へ行かない -->
    <Compile Include="Semantics.fs" />
    <!-- 本文の構造（v2.4）。**深さの並びから木にする** -->
    <Compile Include="Outline.fs" />
    <Compile Include="SourceLanguage.fs" />
    <Compile Include="Languages/Lookup.fs" />
    <Compile Include="Languages/Xml.fs" />
    <Compile Include="Languages/Sxml.fs" />
    <Compile Include="Languages/Fsb.fs" />
    <!-- **`Lookup` の `Shape` に載せない。** CE の形は DTD から引けない。
         理由はファイルの頭に書いてある -->
    <Compile Include="Languages/Fsharp.fs" />
  </ItemGroup>
</Project>
