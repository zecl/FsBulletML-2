<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>FsBulletML2.TypeProvider</RootNamespace>
    <AssemblyName>FsBulletML2.TypeProviders</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>FsBulletML2.TypeProviders</PackageId>
    <Description>F# type providers for BulletML: turn an XML, SXML or FSB pattern into a typed value at compile time.</Description>
    <!-- The compiler loads a type provider from typeproviders/fsharp41/<tfm>/ in the package
         (see the target at the bottom). lib/ keeps the same assembly for run time. -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackTypeProviderDesignTime</TargetsForTfmSpecificContentInPackage>
    <!-- A type provider assembly must be loaded with its full implementation at design/compile
         time. The SDK's separate, method-body-stripped reference assembly (used elsewhere purely
         to speed up incremental builds) is not usable here - consumers would load stub bodies
         and every provider member throws. -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <!-- A type provider runs inside the compiler at design time, where its own deps.json is
         never consulted. Library projects do not copy NuGet assemblies to the output folder by
         default, so FParsec.dll (pulled in transitively through FsBulletML2.Parser) was simply
         absent next to FsBulletML2.TypeProviders.dll and every provided type failed with
         "Could not load file or assembly 'FParsec'". Copying the resolved assemblies puts it
         there; TypeProviderForNamespaces(addDefaultProbingLocation = true) is what makes the
         provider look there. Both halves are required - neither works alone. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- ProvidedTypes.fs / .fsi are FSharp.TypeProviders.SDK 8.11.0, taken verbatim from the
         NuGet package's src/ folder. Do not hand-edit them; re-copy from a newer package instead.
         The .NET Framework-era copy that used to live here made every provided type fail with
         FS1108 at the use site.

         tests/FsBulletML2.TypeProviders.Tests is the gate that says these actually work as type
         providers, rather than merely compiling. Run it before and after touching anything here. -->
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="ProvidedTypes.fsi" />
    <Compile Include="ProvidedTypes.fs" />
    <Compile Include="Helper.fs" />
    <Compile Include="Impl.fs" />
    <Compile Include="BulletMLTypeProvider.fs" />
    <Compile Include="BulletMLFromXmlTypeProvider.fs" />
    <Compile Include="BulletMLFromSxmlTypeProvider.fs" />
    <Compile Include="BulletMLFromFsbTypeProvider.fs" />
    <!-- These two were on disk but not in this list, so the types they declare
         (XML<source> / SXML<source>) simply did not exist. Adding them widens the
         published API surface, so the gate covers them now. -->
    <Compile Include="XMLTypeProvider.fs" />
    <Compile Include="FSBTypeProvider.fs" />
    <None Include="app.config" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FsBulletML2.Core\FsBulletML2.Core.fsproj" />
    <ProjectReference Include="..\FsBulletML2.Parser\FsBulletML2.Parser.fsproj" />
  </ItemGroup>
  <!-- The NuGet layout. The compiler loads a type provider from typeproviders/fsharp41/<tfm>/
       in the package, and falls back to lib/ only when that folder is absent.

       A type provider runs inside the compiler, which reads neither the consumer's deps.json nor
       the package dependencies - FsBulletML2.Core, .Parser and FParsec each land in their own
       package folder, not next to this assembly. So the design-time folder carries all of them.
       Every provider registers its own folder with RegisterProbingFolder, so sitting side by
       side is enough. FSharp.Core is not packed; the compiler brings its own.

       FsBulletML (2014) did the same by reading the consumer's packages.config and building
       packages\<Id>.<Version>\lib paths. PackageReference has no packages.config and a different
       folder layout, hence the dedicated folder instead. -->
  <Target Name="PackTypeProviderDesignTime">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)FsBulletML2.TypeProviders.dll;$(OutputPath)FsBulletML2.Core.dll;$(OutputPath)FsBulletML2.Parser.dll;$(OutputPath)FParsec.dll;$(OutputPath)FParsecCS.dll"
                              PackagePath="typeproviders/fsharp41/$(TargetFramework)/" />
    </ItemGroup>
  </Target>
</Project>
