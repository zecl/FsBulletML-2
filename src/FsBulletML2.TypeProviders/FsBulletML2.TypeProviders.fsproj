<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>FsBulletML2.TypeProvider</RootNamespace>
    <AssemblyName>FsBulletML2.TypeProviders</AssemblyName>
    <!-- A type provider assembly must be loaded with its full implementation at design/compile
         time. The SDK's separate, method-body-stripped reference assembly (used elsewhere purely
         to speed up incremental builds) is not usable here - consumers would load stub bodies
         and every provider member throws. -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <!-- This project builds clean, but "builds" is the only thing anything checks about it.
         The one place that consumes the generated types - samples/FsBulletML2.Sample.TypeProviders.Debug -
         does not build (FS1108) and is not in FsBulletML2.sln, so nothing here is exercised as a
         type provider. The vendored ProvidedTypes.fs is the .NET Framework-era SDK. See that
         sample's README.md before changing anything in here. -->
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="ProvidedTypes.fsi" />
    <Compile Include="ProvidedTypes.fs" />
    <Compile Include="DebugProvidedTypes.fs" />
    <Compile Include="Helper.fs" />
    <Compile Include="Impl.fs" />
    <Compile Include="BulletMLTypeProvider.fs" />
    <Compile Include="BulletMLFromXmlTypeProvider.fs" />
    <Compile Include="BulletMLFromSxmlTypeProvider.fs" />
    <Compile Include="BulletMLFromFsbTypeProvider.fs" />
    <None Include="Script.fsx" />
    <None Include="app.config" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FsBulletML2.Core\FsBulletML2.Core.fsproj" />
    <ProjectReference Include="..\FsBulletML2.Parser\FsBulletML2.Parser.fsproj" />
  </ItemGroup>
</Project>
