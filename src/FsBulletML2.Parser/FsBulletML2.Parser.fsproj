<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>FsBulletML2.Parser</RootNamespace>
    <AssemblyName>FsBulletML2.Parser</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>FsBulletML2.Parser</PackageId>
    <Description>Reads BulletML in XML, SXML and FSB notation into the FsBulletML2.Core tree.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Xml.fs" />
    <Compile Include="XmlWrite.fs" />
    <Compile Include="Sxml.fs" />
    <Compile Include="Offside.fs" />
    <Compile Include="Parser.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FParsec" Version="1.1.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FsBulletML2.Core\FsBulletML2.Core.fsproj" />
  </ItemGroup>
</Project>
