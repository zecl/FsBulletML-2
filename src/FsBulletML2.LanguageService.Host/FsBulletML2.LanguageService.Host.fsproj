<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Language Service の、**.NET でしか走らない側。**

    ## なぜ 2 つ に割れているか

    器（`FsBulletML2.LanguageService`）は Fable が `ProjectReference` を
    辿って**まるごと**焼く。焼く範囲を proj の中で選ぶ口は無いので、
    **Fable で焼けないものを器に置くと器ごと焼けなくなる。**

    実測（v0.8 の頭で、器に入れて fable を回した）——

        Parser を参照した瞬間          FParsec は dll 参照で F# ソースを含まない。
                                       Offside.fs が全行 赤
        UnionCaseInfo
          .GetCustomAttributes         Fable 非対応
        System.Text.Encoding
          .GetEncoding / StreamReader  Fable 非対応

    だからこちらに置くのは「Core / Parser を読んで、ブラウザへ渡す材料を
    作るもの」。**割れ目は測定が決めた**（設計の趣味ではない）。

    ## 名前空間は器と同じ

    `FsBulletML2.LanguageService`。**proj が 2 つ に割れているのは Fable の
    都合**であって、概念としては 1 つ の Language Service。
    使う側は `open` 1 行 で両方 を引く。

    ## 配らない

    nuspec を足さない。器と同じ扱い。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>FsBulletML2.LanguageService</RootNamespace>
    <AssemblyName>FsBulletML2.LanguageService.Host</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- 順は依存の順。Vocabulary が Spec を引き、References が Vocabulary を引き、
         SourceReader が Diagnosis と器のスキャナを束ねる -->
    <Compile Include="Spec.fs" />
    <Compile Include="Frames.fs" />
    <Compile Include="Vocabulary.fs" />
    <!-- 読んだ木のノードと札を順番で結ぶ（v3.1 の段 4）。**名前の表を持たない** -->
    <Compile Include="NodeOrder.fs" />
    <!-- FsharpCe は Dsl と FCS しか使わない。**Diagnosis より先** -->
    <Compile Include="FsharpCe.fs" />
    <Compile Include="Diagnosis.fs" />
    <Compile Include="References.fs" />
    <Compile Include="SourceReader.fs" />
    <!-- 書く口。**読む口の対**（v1.4 で足した。それまで書けたのは XML だけ） -->
    <Compile Include="SourceWriter.fs" />
  </ItemGroup>
  <ItemGroup>
    <!--
      **F# の CE を読むために FCS を引く。** 型検査はしない（parse だけ）——
      型検査まで通すには参照アセンブリをブラウザへ配ることになる。

      **配る値段は測ってある**（v1.0 の頭）—— ブラウザが起動で受け取る
      バイトが 9.27 MB -> 15.41 MB（うち FCS 5.99 MB）。publish 成果物の
      ほうは brotli で 9.5 MB -> 15.7 MB（FCS 単体 6.12 MB）。
      **軸が 2 つ ある** ——
      置く値段ではなく、**使わなくても起動で払う値段**のほうが効く。

      最初、ブラウザの resource timing で測って「起動では 1 度 も
      取りに行かない」と読んだ。**あれは 250 件 で頭打ちになっていた**
      （溢れは黙って落ちる）。数え直しは配る側の node でやった。

      **版は FSharp.Core に合わせる。** ずれると NU1608 が 4 件 出る
      （43.12.204 は FSharp.Core 10.1.204 を要るが、この repo は 10.1.400）。
      **警告が出ること自体は走行に出ない**ので、上げるときは揃っているか見ること。
    -->
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.400" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FsBulletML2.LanguageService\FsBulletML2.LanguageService.fsproj" />
    <ProjectReference Include="..\FsBulletML2.Core\FsBulletML2.Core.fsproj" />
    <ProjectReference Include="..\FsBulletML2.Parser\FsBulletML2.Parser.fsproj" />
    <!-- **CE の意味論は書き直さない。** 歩いたあとに呼ぶのはこの Dsl そのもの -->
    <ProjectReference Include="..\FsBulletML2.Dsl\FsBulletML2.Dsl.fsproj" />
  </ItemGroup>
</Project>
