<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <RootNamespace>FsBulletML2.Core.Tests</RootNamespace>
    <AssemblyName>FsBulletML2.Core.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Fake.fs" />
    <Compile Include="StepEntry.fs" />
    <Compile Include="EnvTests.fs" />
    <Compile Include="Trace.fs" />
    <Compile Include="TraceNew.fs" />
    <Compile Include="TraceApi.fs" />
    <Compile Include="Divergence.fs" />
    <Compile Include="Golden.fs" />
    <Compile Include="Smoke.fs" />
    <Compile Include="Timing.fs" />
    <Compile Include="Behavior.fs" />
    <Compile Include="ChangeCommands.fs" />
    <Compile Include="Refs.fs" />
    <Compile Include="RandRank.fs" />
    <Compile Include="RefParamFreeze.fs" />
    <Compile Include="BulletDirection.fs" />
    <Compile Include="BulletAim.fs" />
    <Compile Include="NullNewBullet.fs" />
    <Compile Include="Degenerate.fs" />
    <Compile Include="Expressions.fs" />
    <Compile Include="ShootingType.fs" />
    <Compile Include="Culture.fs" />
    <Compile Include="Omitted.fs" />
    <Compile Include="FireShapes.fs" />
    <Compile Include="PlayerAndTops.fs" />
    <Compile Include="StateIsolation.fs" />
    <Compile Include="RoundTrip.fs" />
    <Compile Include="Corpus.fs" />
    <Compile Include="ExprTests.fs" />
    <Compile Include="StepWithEquiv.fs" />
    <Compile Include="Equivalence.fs" />
    <Compile Include="SelfReference.fs" />
    <Compile Include="CallingConvention.fs" />
    <Compile Include="ProgressTests.fs" />
    <Compile Include="SimTests.fs" />
    <Compile Include="StepCommands.fs" />
    <Compile Include="StepFire.fs" />
    <Compile Include="StepTop.fs" />
    <Compile Include="RootAccel.fs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\TestData\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="FsUnit" Version="5.0.1" />
    <!-- 行と分岐のカバレッジを出すために要る（XPlat Code Coverage の収集器） -->
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FsBulletML2.Core\FsBulletML2.Core.fsproj" />
    <ProjectReference Include="..\..\src\FsBulletML2.Parser\FsBulletML2.Parser.fsproj" />
  </ItemGroup>
</Project>
