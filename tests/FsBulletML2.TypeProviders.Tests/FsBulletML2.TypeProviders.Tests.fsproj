<Project Sdk="Microsoft.NET.Sdk">
  <!-- 型プロバイダが「型プロバイダとして働く」かを見る門。生成した型から
       プロパティを 1 つ 読むだけの試験が 6 本。

       置いたときは赤だった（同梱の ProvidedTypes.fs が .NET Framework 時代の
       SDK で FS1108）。SDK を 8.11.0 へ差し替え、設計時の probing を直して
       緑になり、FsBulletML2.sln に入れた。経緯は
       samples/FsBulletML2.Sample.TypeProviders.Debug/README.md。

       **ここが赤いときは sln から外すこと。** 入れたまま赤くすると
       dotnet test がソリューションごと落ちて、他の 554 本 が走らなくなる。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <RootNamespace>FsBulletML2.TypeProviders.Tests</RootNamespace>
    <AssemblyName>FsBulletML2.TypeProviders.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Gate.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="FsUnit" Version="5.0.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FsBulletML2.Core\FsBulletML2.Core.fsproj" />
    <ProjectReference Include="..\..\src\FsBulletML2.Parser\FsBulletML2.Parser.fsproj" />
    <ProjectReference Include="..\..\src\FsBulletML2.TypeProviders\FsBulletML2.TypeProviders.fsproj" />
  </ItemGroup>
</Project>
