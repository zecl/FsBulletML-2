<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>true</GenerateProgramFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>FsBulletML2.Front.Tests</RootNamespace>
    <AssemblyName>FsBulletML2.Front.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Corpus.fs" />
    <Compile Include="AimingFreeze.fs" />
    <Compile Include="PublicSurface.fs" />
    <Compile Include="NoAimSkip.fs" />
    <Compile Include="DriverEquiv.fs" />
    <!--
      Playground のソースを借りて compile し直す。**参照はしない** ——
      あちらは Blazor WASM のアプリで、こちらから引くものではない。
      借りている中身は Core / Front の型しか使わないので、依存は増えない。
      **`Parser.Tests` では借りられない** —— あちらは Front を参照していない。
      同じ形の前例: Parser.Tests が Vocabulary.fs / XmlScan.fs を借りている。
    -->
    <Compile Include="..\..\src\FsBulletML2.Playground\Stage.fs" Link="Stage.fs" />
    <Compile Include="..\..\src\FsBulletML2.Playground\Rand.fs" Link="Rand.fs" />
    <Compile Include="..\..\src\FsBulletML2.Playground\Player.fs" Link="Player.fs" />
    <Compile Include="..\..\src\FsBulletML2.Playground\BrowserEnv.fs" Link="BrowserEnv.fs" />
    <Compile Include="..\..\src\FsBulletML2.Playground\Pacing.fs" Link="Pacing.fs" />
    <Compile Include="..\..\src\FsBulletML2.Playground\Seek.fs" Link="Seek.fs" />
    <!-- **器 の Host からも 1 本 借りる。** `Focus.fs` が読んだ木を歩くのに使う。
         参照を足さないのは、あちらが Parser / Dsl まで引くから ——
         この 1 本 が使うのは Core の型と reflection だけ -->
    <Compile Include="..\..\src\FsBulletML2.LanguageService.Host\NodeOrder.fs" Link="NodeOrder.fs" />
    <Compile Include="..\..\src\FsBulletML2.Playground\Focus.fs" Link="Focus.fs" />
    <Compile Include="..\..\src\FsBulletML2.Playground\Playfield.fs" Link="Playfield.fs" />
    <Compile Include="DeterministicField.fs" />
    <Compile Include="StepPacing.fs" />
    <Compile Include="SeekFrames.fs" />
    <!-- 種と難度（v2.0）。**リンクが指しているのは「その走り」** -->
    <Compile Include="SeededRuns.fs" />
    <!-- 画面の向きと自機（v2.0）。**弾幕が面の形を決める** -->
    <Compile Include="ViewFacing.fs" />
    <!-- 2 面（v2.1）。**並べたことで絵が変わったら比べられない** -->
    <Compile Include="TwoFields.fs" />
    <!-- 追っている弾の再開点（v3.1 の段 3）。**読んだ木と参照で突き合わせる** -->
    <Compile Include="FocusResume.fs" />
    <!-- どの撃つ腕が何発 撃ったか（v3.3 の段 1）。**合計で当てる** -->
    <Compile Include="FocusTally.fs" />
  </ItemGroup>
  <!-- 版は Core.Tests に合わせる。別の版を混ぜると、落ちたときに
       手のせいか版のせいかが割れない -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="FsUnit" Version="5.0.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FsBulletML2.Front\FsBulletML2.Front.fsproj" />
    <ProjectReference Include="..\..\src\FsBulletML2.Parser\FsBulletML2.Parser.fsproj" />
  </ItemGroup>
</Project>
