<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <RootNamespace>FsBulletML2.Parser.Tests</RootNamespace>
    <AssemblyName>FsBulletML2.Parser.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Util.fs" />
    <Compile Include="XmlParse.fs" />
    <Compile Include="OtherParse.fs" />
    <Compile Include="Snippet.fs" />
    <Compile Include="ReadEntryPoints.fs" />
    <!--
      Playground のソースを借りて compile し直す。**参照はしない** ——
      あちらは Blazor WASM のアプリで、こちらから引くものではない。
      借りている中身は Core の型しか使わないので、依存は増えない。
      同じ形の前例: bench/FsBulletML2.Benchmarks が Core.Tests の Fake.fs を借りている。
    -->
    <Compile Include="..\..\src\FsBulletML2.Playground\Vocabulary.fs" Link="Vocabulary.fs" />
    <Compile Include="VocabularyCoverage.fs" />
    <!--
      Fable 側のソースも借りる。**カーソルの居場所の判定は、ブラウザでしか
      当てられないと CI で一度も回らない。** 中身は文字列を数えるだけで
      JS を呼ばないので .NET でもそのまま走る（[<Emit>] の口には触らない）。
    -->
    <Compile Include="..\..\src\FsBulletML2.Playground\fable\SourceLanguage.fs" Link="SourceLanguage.fs" />
    <Compile Include="..\..\src\FsBulletML2.Playground\fable\languages\Xml.fs" Link="languages\Xml.fs" />
    <Compile Include="XmlContext.fs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\TestData\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="FsUnit" Version="5.0.1" />
    <PackageReference Include="FParsec" Version="1.1.1" />
    <!-- 借りている Fable のソースが [<Emit>] を使う。**呼ばないので実体は要らない** -->
    <PackageReference Include="Fable.Core" Version="4.5.1" />
    <!-- 行と分岐のカバレッジを出すために要る（XPlat Code Coverage の収集器） -->
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FsBulletML2.Core\FsBulletML2.Core.fsproj" />
    <ProjectReference Include="..\..\src\FsBulletML2.Parser\FsBulletML2.Parser.fsproj" />
  </ItemGroup>
</Project>
