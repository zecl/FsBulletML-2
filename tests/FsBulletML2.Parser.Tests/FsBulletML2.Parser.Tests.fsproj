<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <RootNamespace>FsBulletML2.Parser.Tests</RootNamespace>
    <AssemblyName>FsBulletML2.Parser.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Util.fs" />
    <Compile Include="XmlParse.fs" />
    <Compile Include="OtherParse.fs" />
    <Compile Include="Snippet.fs" />
    <Compile Include="ReadEntryPoints.fs" />
    <Compile Include="VocabularyCoverage.fs" />
    <Compile Include="SpecCoverage.fs" />
    <Compile Include="AttributeDefaults.fs" />
    <Compile Include="DtdLines.fs" />
    <Compile Include="DiagnosisLayers.fs" />
    <Compile Include="XmlToken.fs" />
    <Compile Include="ReferenceScan.fs" />
    <Compile Include="XmlContext.fs" />
    <Compile Include="XmlCompletion.fs" />
    <Compile Include="HoverMarkdown.fs" />
    <!-- sxml（v0.9）。XML 側と対で、名前が対応している -->
    <Compile Include="SxmlReader.fs" />
    <Compile Include="SxmlToken.fs" />
    <Compile Include="SxmlReferenceScan.fs" />
    <Compile Include="SxmlContext.fs" />
    <Compile Include="SxmlCompletion.fs" />
    <!-- F# の CE（v1.0）。目盛りは同梱カタログの**値**そのもの -->
    <Compile Include="FsharpCeCorpus.fs" />
    <!-- インデント記法（v1.1）。sxml と同じ 5 本 で、名前が対応している -->
    <Compile Include="FsbReader.fs" />
    <Compile Include="FsbToken.fs" />
    <Compile Include="FsbReferenceScan.fs" />
    <Compile Include="FsbContext.fs" />
    <Compile Include="FsbCompletion.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- **CE の本文を試験の出力へ写す。** 期待値は `Bullets.Dsl` の値なので、
         突き合わせるには「その値を組んだ本文」が要る。
         **写せていなければ 0 本 で緑になる**ので、本数を先に見る点を置いてある -->
    <Content Include="..\..\src\FsBulletML2.Bullets.Dsl\**\*.fs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>BulletsDsl\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\TestData\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="FsUnit" Version="5.0.1" />
    <PackageReference Include="FParsec" Version="1.1.1" />

    <!-- 行と分岐のカバレッジを出すために要る（XPlat Code Coverage の収集器） -->
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FsBulletML2.Core\FsBulletML2.Core.fsproj" />
    <ProjectReference Include="..\..\src\FsBulletML2.Parser\FsBulletML2.Parser.fsproj" />
    <!--
      **借りずに参照する（v0.8）。** 前は Playground のソースを `Link` で
      借りて compile し直していた。**`affected.ps1` は `Link` を追わない**ので、
      借りたソースを触っても、借りている試験が CI で選ばれなかった
      （実測。移す前は 7 本 どれを触っても 試験 0 本）。
    -->
    <ProjectReference Include="..\..\src\FsBulletML2.LanguageService\FsBulletML2.LanguageService.fsproj" />
    <ProjectReference Include="..\..\src\FsBulletML2.LanguageService.Host\FsBulletML2.LanguageService.Host.fsproj" />
    <!-- **目盛りの正本。** F# コンパイラが組んだ 176 本 の値と突き合わせる -->
    <ProjectReference Include="..\..\src\FsBulletML2.Bullets.Dsl\FsBulletML2.Bullets.Dsl.fsproj" />
  </ItemGroup>
</Project>
