<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>FsBulletML2.Sample.Unity2D.FSharp</RootNamespace>
    <AssemblyName>FsBulletML2.Sample.Unity2D.FSharp</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- R3 の発火源。誰にも依存しないので先頭 -->
    <Compile Include="FrameTicker.fs" />
    <Compile Include="BulletFunctions.fs" />
    <Compile Include="IBullet.fs" />
    <Compile Include="BaseBullet.fs" />
    <Compile Include="EnemyBullet.fs" />
    <Compile Include="PlayerBullet.fs" />
    <Compile Include="Bomb.fs" />
    <!-- ECS。BulletEcs が型（BulletSim / FrontEnv）、Factory が生成、
         Driver が毎コマ回す。Enemy / Player より前に置く（あちらが使う） -->
    <!-- URP の安全網。Driver より前（あちらが呼ぶ） -->
    <Compile Include="UrpPlayModeCompat.fs" />
    <Compile Include="BulletEcs.fs" />
    <Compile Include="BulletEntityFactory.fs" />
    <Compile Include="Enemy.fs" />
    <Compile Include="Player.fs" />
    <!-- Driver は Enemy / Player を参照するので、そのあと -->
    <Compile Include="BulletEcsDriver.fs" />
    <Compile Include="Informations.fs" />
    <Compile Include="BgScroll.fs" />
    <Compile Include="ParticleSortingLayer.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\FsBulletML2.Core\FsBulletML2.Core.fsproj" />
    <ProjectReference Include="..\..\..\src\FsBulletML2.Unity2D\FsBulletML2.Unity2D.fsproj" />
    <ProjectReference Include="..\..\FsBulletML2.Bullets.Dsl\FsBulletML2.Bullets.Dsl.fsproj" />
    <!-- COMPILE-ONLY UnityEngine stub. Not a substitute for the Unity Editor. -->
    <ProjectReference Include="..\..\..\src\UnityEngine.Stub\UnityEngine.Stub.csproj" Condition="'$(UseRealUnity)' != 'true'" />
  </ItemGroup>
  <!-- R3 と、その F# 向けの包み。

       **R3 本体は NuGet から参照し、Assets へは置かない。** Unity 側には
       同じ 1.3.1 が UPM（org.nuget.r3）で入る。両方置くと同名アセンブリが
       2 つ になるので、Assets へ配るのは FSharp.Control.R3.dll だけ。

       **UseRealUnity でも NuGet の R3 を参照する。** ここで要るのは
       コンパイル時の型だけで、実行時に読まれるのは Unity 側の R3。
       版を 1.3.1 でそろえてあるので中身は同じ。

       **R3.Unity（com.cysharp.r3）の API は使わない。** `Observable.EveryUpdate`
       も `AddTo(Component)` も `R3.Triggers` もあちらに居るが、それらは
       UnityEngine.Stub でビルドする経路に持ち込めない ——
       `namespace R3` に `static class Observable` をもう 1 つ 置くことになり、
       本物と衝突する（CS0433）。代わりが `FrameTicker` と
       `RegisterTo(destroyCancellationToken)`。詳しくは FrameTicker.fs -->
  <ItemGroup>
    <PackageReference Include="R3" Version="1.3.1" />
    <PackageReference Include="FSharp.Control.R3" Version="0.3.1" />
  </ItemGroup>
  <!-- ECS のアセンブリ。**Unity がビルドした Library/ScriptAssemblies を指す。**
       PackageCache には dll が無く（ソースで配られている）、Unity が
       プロジェクトごとにビルドする。**だから一度 Unity にプロジェクトを
       開かせてからでないと、ここは解決しない。** -->
  <PropertyGroup Condition="'$(UnityScriptAssemblies)' == ''">
    <UnityScriptAssemblies>$(MSBuildThisFileDirectory)..\Library\ScriptAssemblies</UnityScriptAssemblies>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseRealUnity)' == 'true'">
    <Reference Include="Unity.Entities">
      <HintPath>$(UnityScriptAssemblies)\Unity.Entities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Collections">
      <HintPath>$(UnityScriptAssemblies)\Unity.Collections.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(UnityScriptAssemblies)\Unity.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Transforms">
      <HintPath>$(UnityScriptAssemblies)\Unity.Transforms.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Entities.Graphics">
      <HintPath>$(UnityScriptAssemblies)\Unity.Entities.Graphics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Burst">
      <HintPath>$(UnityScriptAssemblies)\Unity.Burst.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime">
      <HintPath>$(UnityScriptAssemblies)\Unity.RenderPipelines.Universal.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime">
      <HintPath>$(UnityScriptAssemblies)\Unity.RenderPipelines.Core.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- RuntimeInitializeOnLoadMethod が PreserveAttribute を要求する。
         属性そのものは CoreModule に在るが、その基底がこちらに居る -->
    <Reference Include="Unity.Scripting">
      <HintPath>$(UnityManaged)\Unity.Scripting.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.MathematicsModule">
      <HintPath>$(UnityManaged)\UnityEngine.MathematicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(UnityManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(UnityManaged)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(UnityManaged)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(UnityManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
