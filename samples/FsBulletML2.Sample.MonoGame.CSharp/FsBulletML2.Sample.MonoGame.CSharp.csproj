<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FsBulletML2.Sample.MonoGame.CSharp</RootNamespace>
    <AssemblyName>FsBulletML2.Sample.MonoGame.CSharp</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Background.cs" />
    <Compile Include="BulletFunctions.cs" />
    <Compile Include="Enemy.cs" />
    <Compile Include="EnemyControl.cs" />
    <Compile Include="Fps.cs" />
    <Compile Include="FsBulletML2SampleGame.cs" />
    <Compile Include="IEnemy.cs" />
    <Compile Include="Particle.cs" />
    <Compile Include="ParticleEmitter.cs" />
    <Compile Include="Player.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Content\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FsBulletML2.Core\FsBulletML2.Core.fsproj" />
    <ProjectReference Include="..\..\src\FsBulletML2.Parser\FsBulletML2.Parser.fsproj" />
    <ProjectReference Include="..\..\src\FsBulletML2.MonoGame\FsBulletML2.MonoGame.fsproj" />
    <ProjectReference Include="..\FsBulletML2.Bullets.Dsl\FsBulletML2.Bullets.Dsl.fsproj" />
    <ProjectReference Include="..\FsBulletML2.Sample.MonoGame.Font\FsBulletML2.Sample.MonoGame.Font.csproj" />
  </ItemGroup>
</Project>
