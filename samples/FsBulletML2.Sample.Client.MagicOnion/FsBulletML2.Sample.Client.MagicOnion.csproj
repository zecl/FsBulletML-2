<Project Sdk="Microsoft.NET.Sdk">

  <!--
    数えるだけの client。**F# を 1 本 も参照しない。**

    Unity 側 は dll を消し忘れても絵 が出てしまう（参照が残っているだけで動く）
    ので、目 では出ない。ここは参照が 1 本 でも増えれば焼けなくなる ——
    **門 の当たる先を、Unity の外にもう 1 つ 置いてある。**
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>FsBulletML2.Sample.Client.MagicOnion</RootNamespace>
    <AssemblyName>FsBulletML2.Sample.Client.MagicOnion</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MagicOnion.Client" Version="7.10.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FsBulletML2.Sample.Shared.MagicOnion.Compile\FsBulletML2.Sample.Shared.MagicOnion.Compile.csproj" />
  </ItemGroup>

</Project>
